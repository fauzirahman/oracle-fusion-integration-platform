generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Employee {
  id             String   @id @default(uuid())
  oracleId       String   @unique
  employeeNumber String?  @unique
  firstName      String
  lastName       String
  displayName    String
  email          String?
  departmentId   String?
  jobTitle       String?
  status         String
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
}

model Department {
  id         String     @id @default(uuid())
  oracleId   String     @unique
  name       String
  code       String?
  managerId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  employees  Employee[]
}

model SyncLog {
  id            String   @id @default(uuid())

  entity        String
  entityId      String?

  operation     String

  status        SyncStatus

  totalRecords  Int      @default(0)

  duration      Int?

  message       String?

  startedAt     DateTime
  finishedAt    DateTime?

  createdAt     DateTime @default(now())
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Supplier {
  id             String   @id @default(uuid())
  oracleId       String   @unique
  supplierNumber String?  @unique
  supplierName   String
  taxNumber      String?
  email          String?
  phone          String?
  status         String?
  syncedAt       DateTime

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum SyncOperation {
  FULL
  INCREMENTAL
  MANUAL
  SCHEDULED
}

model SyncCheckpoint {
  id            String   @id @default(uuid())

  jobName       String   @unique

  lastSyncAt    DateTime?

  lastSuccessAt DateTime?

  createdAt     DateTime @default(now())

  updatedAt     DateTime @updatedAt
}

model SyncHistory {
  id          String      @id @default(uuid())

  jobName     String

  startedAt   DateTime

  finishedAt  DateTime

  status      SyncStatus

  total       Int
  inserted    Int
  updated     Int
  failed      Int

  errorMessage String?

  createdAt DateTime @default(now())

  @@index([jobName])
  @@index([startedAt])
}
