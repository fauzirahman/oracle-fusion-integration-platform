generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id             String   @id @default(uuid())
  oracleId       String   @unique
  employeeNumber String?  @unique
  firstName      String
  lastName       String
  displayName    String
  email          String?
  departmentId   String?
  jobTitle       String?
  status         String
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
}

model Department {
  id         String     @id @default(uuid())
  oracleId   String     @unique
  name       String
  code       String?
  managerId  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  employees  Employee[]
}

model SyncLog {
  id          String   @id @default(uuid())
  entity      String
  entityId    String?
  action      String
  status      String
  message     String?
  startedAt   DateTime
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
}